# Shared Ditto credentials for both the iOS and Android apps. Copy this file to
# .env at the repo root and fill in the values from your Ditto portal — create a
# database at https://portal.ditto.live.
#
# Format contract — parsed by both Android's Gradle build (java.util.Properties)
# and iOS/buildEnv.sh, so keep it simple:
#   - KEY=VALUE, one per line; values are UNQUOTED (no surrounding quotes)
#   - no spaces around '='
#   - lines starting with '#' are comments
#   - every value must be filled in; a blank value fails the build
DITTO_DATABASE_ID=
DITTO_DEVELOPMENT_TOKEN=
DITTO_SERVER_URL=
